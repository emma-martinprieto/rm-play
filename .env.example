# Copia este archivo a .env y rellena tu token real.
# Obtén el token con: npx github:adobe-rnd/da-auth-helper token
# (o invoca la skill aem-edge-delivery-services:da-auth)
DA_TOKEN=

# Opcionales — solo si el org/repo de da.live difiere del remoto de GitHub
# de este proyecto (por defecto se autodetectan de .git/config):
# DA_ORG=
# DA_REPO=
# DA_BRANCH=main
